# ═══════════════════════════════════════════════════════════════════════════════
# CHATWOOT WEBHOOK & SUPABASE EDGE FUNCTION - CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# CHATWOOT CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────
# Get these from: https://app.chatwoot.com

# Chatwoot dashboard URL (usually this for cloud)
CHATWOOT_API_URL=https://app.chatwoot.com

# Your Chatwoot Account ID
# Where to find: Go to https://app.chatwoot.com/app/accounts/[ACCOUNT_ID]/dashboard
# Copy the number from the URL
CHATWOOT_ACCOUNT_ID=your_account_id

# Your Chatwoot API Token (Access Token)
# Where to find: Profile menu → Profile Settings → Access Tokens → Copy token
CHATWOOT_API_TOKEN=your_api_token

# Webhook Secret (OPTIONAL but recommended for security)
# Where to find: Settings → Integrations → Webhooks → Create new → Copy secret
CHATWOOT_WEBHOOK_SECRET=your_webhook_secret


# ───────────────────────────────────────────────────────────────────────────────
# SUPABASE CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com

# Your Supabase project URL
# Where to find: Settings → API → Project URL
# Format: https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon Key
# Where to find: Settings → API → Anon Key (public)
# This is the public key, safe to expose in edge functions
SUPABASE_ANON_KEY=your_anon_key


# ───────────────────────────────────────────────────────────────────────────────
# OPENAI CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────
# Get these from: https://platform.openai.com

# Your OpenAI API Key
# Where to find: https://platform.openai.com/account/api-keys → Create new secret key
OPENAI_API_KEY=sk-proj-your_api_key

# Your OpenAI Organization ID (OPTIONAL)
# Where to find: https://platform.openai.com/account/org-settings/organization/overview
# Only needed if you have multiple organizations
OPENAI_ORG_ID=org-your_org_id


# ───────────────────────────────────────────────────────────────────────────────
# TAVILY SEARCH API (OPTIONAL)
# ───────────────────────────────────────────────────────────────────────────────
# For web search functionality
# Get from: https://app.tavily.com

# Your Tavily API Key
# Where to find: https://app.tavily.com/home → Copy API Key
# This is optional - without it, the bot won't do web searches
TAVILY_API_KEY=tvly-your_api_key


# ───────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (only used when running npm run chatwoot locally)
# ───────────────────────────────────────────────────────────────────────────────

# Port where local Express server listens
PORT=3000


# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════════════════════
#
# LOCAL DEVELOPMENT (npm run chatwoot + ngrok):
#   - Copy this file to .env
#   - Fill in all CHATWOOT_*, SUPABASE_*, and OPENAI_* variables
#   - PORT is used here
#
# SUPABASE EDGE FUNCTION (recommended):
#   - These variables should be set in Supabase Dashboard
#   - Run: supabase secrets set VARIABLE_NAME=value
#   - PORT is NOT used (Edge Functions are stateless)
#
# IMPORTANT: Never commit .env file with real values to git!
# ═══════════════════════════════════════════════════════════════════════════════
